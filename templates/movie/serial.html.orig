                                :class="activeSeason === s ? 'text-white border-white' : 'text-[#484848] border-[#FFFFFF33] hover:text-white'"
                                class="px-6 py-3 font-medium transition-all bg-transparent border rounded-xl"
                                x-text="s"
                            ></button>
