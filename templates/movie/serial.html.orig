                                    <path
                                        d="M12 21.75C11.894 21.75 11.7879 21.728 11.6889 21.683C11.3619 21.534 3.66598 17.965 2.43198 11.609C1.95498 9.15 2.43398 6.75098 3.71298 5.19298C4.74798 3.93098 6.23594 3.25997 8.01694 3.25097C8.02594 3.25097 8.03494 3.25097 8.04294 3.25097C10.0749 3.25097 11.314 4.408 11.999 5.393C12.687 4.404 13.9359 3.24197 15.9809 3.25097C17.7629 3.25997 19.2519 3.93098 20.2879 5.19298C21.5649 6.74998 22.0429 9.14898 21.5649 11.61C20.3329 17.966 12.6359 21.536 12.3089 21.684C12.2119 21.728 12.106 21.75 12 21.75ZM8.04196 4.74999C8.03596 4.74999 8.03099 4.74999 8.02499 4.74999C6.68699 4.75599 5.62702 5.22497 4.87302 6.14397C3.87402 7.36097 3.513 9.29699 3.905 11.323C4.86 16.247 10.593 19.447 12 20.165C13.407 19.447 19.14 16.247 20.094 11.323C20.488 9.29599 20.127 7.35997 19.13 6.14397C18.376 5.22597 17.3159 4.75797 15.9749 4.75097C15.9689 4.75097 15.963 4.75097 15.958 4.75097C13.586 4.75097 12.745 7.12799 12.711 7.22899C12.607 7.53199 12.3209 7.73797 12.0009 7.73797C11.9989 7.73797 11.9979 7.73797 11.9969 7.73797C11.6759 7.73697 11.3899 7.53198 11.2879 7.22698C11.2549 7.12698 10.413 4.74999 8.04196 4.74999Z"
