        <section
            x-data="{ 
    activeSeason: 'فصل اول', 
    openSeason: false, 
    openSort: false, 
    sortOrder: 'جدیدترین',
    seasons: {
        'فصل اول': { num: '۱', episodes: [1, 2] },
        'فصل دوم': { num: '۲', episodes: [1, 2] },
        'فصل سوم': { num: '۳', episodes: [] },
        'فصل چهارم': { num: '۴', episodes: [] },
        'فصل پنجم': { num: '۵', episodes: [] }
    }
}"
            class="w-full bg-[#050505] px-4 md:px-12 lg:px-24 py-6"
            id="tab-section"
        >
            <div
                class="flex items-center justify-start gap-6 mb-8 overflow-x-auto border-b border-white/10 no-scrollbar"
            >
                <button
                    @click="activeTab = 'episodes'"
                    :class="activeTab === 'episodes' ? 'text-white font-bold' : 'text-[#737373] hover:text-gray-300'"
                    class="relative pb-4 md:text-[23px] transition-all px-3 whitespace-nowrap text-white font-bold-nowrap"
                >
                    قسمت‌ها
                    <span
                        x-show="activeTab === 'episodes'"
                        class="absolute bottom-0 left-0 w-full h-[4.21px] shadow-[0px_0px_10px_0px_#D40000] rounded-[10px] bg-gradient-to-r from-[#D02626] to-[#D40000]"
                    >
                    </span>
                </button>

                <button
                    @click="activeTab = 'trailers'"
                    :class="activeTab === 'trailers' ? 'text-white font-bold' : 'text-[#737373] hover:text-gray-300'"
                    class="relative pb-4 md:text-[23px] transition-all px-3 whitespace-nowrap text-white font-bold-nowrap"
                >
                    تریلرها
                    <span
                        x-show="activeTab === 'trailers'"
                        class="absolute bottom-0 left-0 w-full h-[4.21px] shadow-[0px_0px_10px_0px_#D40000] rounded-[10px] bg-gradient-to-r from-[#D02626] to-[#D40000]"
                    >
                    </span>
                </button>

                <button
                    @click="activeTab = 'similar'"
                    :class="activeTab === 'similar' ? 'text-white font-bold' : 'text-[#737373] hover:text-gray-300'"
                    class="relative pb-4 md:text-[23px] transition-all px-3 whitespace-nowrap text-white font-bold-nowrap"
                >
                    فیلم‌های مشابه
                    <span
                        x-show="activeTab === 'similar'"
                        class="absolute bottom-0 left-0 w-full h-[4.21px] shadow-[0px_0px_10px_0px_#D40000] rounded-[10px] bg-gradient-to-r from-[#D02626] to-[#D40000]"
                    >
                    </span>
                </button>

                <button
                    @click="activeTab = 'comments'"
                    :class="activeTab === 'comments' ? 'text-white font-bold' : 'text-[#737373] hover:text-gray-300'"
                    class="relative pb-4 md:text-[23px] transition-all px-3 whitespace-nowrap text-white font-bold-nowrap"
                >
                    دیدگاه‌ها
                    <span
                        x-show="activeTab === 'comments'"
