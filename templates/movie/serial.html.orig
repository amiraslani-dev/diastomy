                                        >
                                            <path
                                                d="M8.00016 1.33325C4.31816 1.33325 1.3335 4.31792 1.3335 7.99992C1.3335 11.6819 4.31816 14.6666 8.00016 14.6666C11.6822 14.6666 14.6668 11.6819 14.6668 7.99992C14.6668 4.31792 11.6822 1.33325 8.00016 1.33325ZM8.50016 10.9999C8.50016 11.2759 8.27616 11.4999 8.00016 11.4999C7.72416 11.4999 7.50016 11.2759 7.50016 10.9999V7.95256C7.50016 7.67656 7.72416 7.45256 8.00016 7.45256C8.27616 7.45256 8.50016 7.67656 8.50016 7.95256V10.9999ZM8.01351 6.33325C7.64551 6.33325 7.34342 6.03458 7.34342 5.66658C7.34342 5.29859 7.63884 4.99992 8.00684 4.99992H8.01351C8.38218 4.99992 8.68018 5.29859 8.68018 5.66658C8.68018 6.03458 8.38151 6.33325 8.01351 6.33325Z"
                                                fill="#727272"
                                            />
                                        </svg>

                                        <span
                                            >نسخه‌های 10bit دارای عمق رنگ بیشتر
                                            و وضوح بهتری می‌باشند.</span
                                        >
                                    </div>
                                </div>
                            </template>

                            <div
                                class="flex items-center justify-around gap-x-2"
                            >
                                <a
                                    href="#"
                                    target="_blank"
                                    class="text-white flex font-medium text-[13px] md:text-base justify-center gap-x-2 items-center w-1/2 px-3 md:px-5 py-3 rounded-4xl bg-[linear-gradient(91.86deg,#7017FF_3.47%,#FE01BC_49.47%,#FE9101_96.47%)]"
                                >
                                    <svg
                                        width="31"
                                        height="31"
                                        viewBox="0 0 31 31"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path
                                            d="M26.9726 10.678C26.8824 8.82316 26.4573 7.17444 25.1048 5.82195C23.7523 4.46947 22.1036 4.0444 20.2488 3.95424C18.3295 3.85119 12.5976 3.85119 10.6912 3.95424C8.83637 4.0444 7.20052 4.46947 5.83515 5.82195C4.46979 7.17444 4.05759 8.82316 3.96742 10.678C3.86438 12.5972 3.86438 18.3292 3.96742 20.2484C4.05759 22.1033 4.48267 23.752 5.83515 25.1045C7.20052 26.457 8.83637 26.8821 10.6912 26.9722C12.6104 27.0753 18.3424 27.0753 20.2488 26.9722C22.1036 26.8821 23.7523 26.457 25.1048 25.1045C26.4573 23.752 26.8824 22.1033 26.9726 20.2484C27.0756 18.3292 27.0756 12.5973 26.9726 10.6909V10.678ZM15.4571 21.5752C12.0823 21.5752 9.33873 18.8316 9.33873 15.4568C9.33873 12.082 12.0823 9.3384 15.4571 9.3384C18.8319 9.3384 21.5755 12.082 21.5755 15.4568C21.5755 18.8316 18.8319 21.5752 15.4571 21.5752ZM22.5673 9.66042C21.8589 9.66042 21.2792 9.08079 21.2792 8.37234C21.2792 7.6639 21.846 7.08426 22.5673 7.08426C23.2758 7.08426 23.8554 7.6639 23.8554 8.37234C23.8554 9.08079 23.2758 9.66042 22.5673 9.66042ZM19.6434 15.4568C19.6434 17.7625 17.7628 19.643 15.4571 19.643C13.1515 19.643 11.2709 17.7625 11.2709 15.4568C11.2709 13.1511 13.1515 11.2705 15.4571 11.2705C17.7628 11.2705 19.6434 13.1511 19.6434 15.4568Z"
                                            fill="white"
                                        />
                                    </svg>

                                    <span>اینستاگرام ما</span>
                                </a>
                                <a
                                    href="#"
                                    target="_blank"
                                    class="text-white flex text-[13px] justify-center gap-x-2 items-center bg-[#00AAFF] w-1/2 px-3 md:px-5 py-3 rounded-4xl"
                                >
                                    <svg
                                        width="31"
                                        height="31"
                                        viewBox="0 0 31 31"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path
                                            d="M5.46151 14.7614C11.6829 12.0307 15.8306 10.2403 17.9173 9.36438C23.8424 6.87838 25.079 6.45331 25.8776 6.44043C26.0579 6.44043 26.4444 6.47908 26.702 6.68517C26.921 6.8655 26.9725 7.09735 27.0111 7.2648C27.0369 7.43225 27.0755 7.81868 27.0498 8.11494C26.7277 11.5155 25.3366 19.7463 24.6282 23.5461C24.3319 25.1562 23.7394 25.6972 23.1726 25.7488C21.9361 25.8647 20.9958 24.9244 19.785 24.1387C17.9044 22.9021 16.8482 22.1293 15.0191 20.9185C12.9066 19.5273 14.272 18.7545 15.4828 17.505C15.7919 17.183 21.2663 12.1853 21.3693 11.7216C21.3822 11.67 21.3951 11.4511 21.2663 11.348C21.1375 11.2321 20.9572 11.2707 20.8283 11.3094C20.6351 11.348 17.6339 13.3445 11.8246 17.2989C10.9745 17.8915 10.2017 18.1749 9.5061 18.162C8.74614 18.1491 7.2777 17.724 6.18283 17.3762C4.84323 16.9383 3.78703 16.7064 3.8772 15.9593C3.92872 15.5729 4.45681 15.1736 5.46151 14.7743V14.7614Z"
                                            fill="white"
                                        />
                                    </svg>

                                    <span>کانال تلگرام ما</span>
                                </a>
                            </div>
                        </div>

                        <div
                            x-show="dlTab === 'dubbed'"
                            style="display: none"
                            x-transition
                            class="flex flex-col items-center justify-center py-10 text-sm text-gray-500"
                        >
                            لینک‌های نسخه دوبله به زودی قرار می‌گیرد.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div
            @open-lang-modal.window="isOpenLanguageBox = true"
            x-show="isOpenLanguageBox"
            style="display: none"
            class="fixed inset-0 z-[110] flex items-center justify-center p-4 sm:p-6"
            dir="rtl"
        >
            <div
                x-show="isOpenLanguageBox"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="absolute inset-0 bg-black/60 backdrop-blur-md"
                @click="isOpenLanguageBox = false"
            ></div>

            <div
                x-show="isOpenLanguageBox"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="relative z-10 w-full max-w-[20rem] shadow-2xl rounded-[2rem] p-[1px] bg-[linear-gradient(149.1deg,rgba(255,255,255,0.18)_9.71%,rgba(255,255,255,0)_103.07%)] flex flex-col"
            >
                <div
                    class="bg-[#0C0C0CCC] rounded-[30px] w-full h-full p-6 flex flex-col items-center relative"
                >
                    <button
                        @click="isOpenLanguageBox = false"
                        class="absolute text-gray-400 transition bg-transparent cursor-pointer right-5 top-6 hover:text-white"
                    >
                        <svg
                            class="w-[25px] h-[25px]"
                            width="30"
                            height="30"
                            viewBox="0 0 30 30"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M18.625 2.5H11.375C10.525 2.5 9.32499 3.00001 8.72499 3.60001L3.60001 8.72501C3.00001 9.32501 2.5 10.525 2.5 11.375V18.625C2.5 19.475 3.00001 20.675 3.60001 21.275L8.72499 26.4C9.32499 27 10.525 27.5 11.375 27.5H18.625C19.475 27.5 20.675 27 21.275 26.4L26.4 21.275C27 20.675 27.5 19.475 27.5 18.625V11.375C27.5 10.525 27 9.32501 26.4 8.72501L21.275 3.60001C20.675 3.00001 19.475 2.5 18.625 2.5Z"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M10.625 19.375L19.375 10.625"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M19.375 19.375L10.625 10.625"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </button>

                    <h3 class="mt-2 mb-6 text-lg font-bold text-white">
                        انتخاب زبان
                    </h3>

                    <div class="flex flex-col w-full gap-2 px-2">
                        <template
                            x-for="lang in ['Persian', 'Spanish', 'Turkey', 'Arabic', 'English']"
                        >
                            <div
                                @click="selectedLang = lang"
                                :class="selectedLang === lang ? ' bg-white/10' : 'border-[#a6a6a616] bg-transparent'"
                                class="flex items-center justify-between w-full px-5 py-3 transition-all duration-300 border cursor-pointer rounded-4xl hover:bg-white/5 group"
                            >
                                <span
                                    :class="selectedLang === lang ? 'text-white' : 'text-white/85 group-hover:text-gray-200'"
                                    class="flex-1 font-semibold text-center transition-colors"
                                    x-text="lang"
                                ></span>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <div
            @open-quality-modal.window="isOpenQuality = true"
            x-show="isOpenQuality"
            style="display: none"
            class="fixed inset-0 z-[110] flex items-center justify-center p-4 sm:p-6"
            dir="rtl"
        >
            <div
                x-show="isOpenQuality"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="absolute inset-0 bg-black/60 backdrop-blur-md"
                @click="isOpenQuality = false"
            ></div>

            <div
                x-show="isOpenQuality"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="relative z-10 w-full max-w-[20rem] shadow-2xl rounded-[2rem] p-[1px] bg-[linear-gradient(149.1deg,rgba(255,255,255,0.18)_9.71%,rgba(255,255,255,0)_103.07%)] flex flex-col"
            >
                <div
                    class="bg-[#0C0C0CCC] rounded-[30px] w-full h-full p-6 flex flex-col items-center relative"
                >
                    <button
                        @click="isOpenQuality = false"
                        class="absolute text-gray-400 transition bg-transparent cursor-pointer right-5 top-6 hover:text-white"
                    >
                        <svg
                            class="w-[25px] h-[25px]"
                            width="30"
                            height="30"
                            viewBox="0 0 30 30"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M18.625 2.5H11.375C10.525 2.5 9.32499 3.00001 8.72499 3.60001L3.60001 8.72501C3.00001 9.32501 2.5 10.525 2.5 11.375V18.625C2.5 19.475 3.00001 20.675 3.60001 21.275L8.72499 26.4C9.32499 27 10.525 27.5 11.375 27.5H18.625C19.475 27.5 20.675 27 21.275 26.4L26.4 21.275C27 20.675 27.5 19.475 27.5 18.625V11.375C27.5 10.525 27 9.32501 26.4 8.72501L21.275 3.60001C20.675 3.00001 19.475 2.5 18.625 2.5Z"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M10.625 19.375L19.375 10.625"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M19.375 19.375L10.625 10.625"
                                stroke="white"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </button>

                    <h3 class="mt-2 mb-6 text-lg font-bold text-white">
                        انتخاب کیفیت
                    </h3>

                    <div class="flex flex-col w-full gap-2 px-2">
                        <template
                            x-for="quality in ['240p', '360p', '480p', '720p', '1080p', 'خودکار']"
                            :key="quality"
                        >
                            <div
                                @click="selectedQuality = quality"
                                :class="selectedQuality === quality ? ' bg-white/10' : 'border-[#a6a6a616] bg-transparent'"
                                class="flex items-center justify-between w-full px-5 py-3 transition-all duration-300 border cursor-pointer rounded-4xl hover:bg-white/5 group"
                            >
                                <span
                                    :class="selectedQuality === quality ? 'text-white' : 'text-white/85 group-hover:text-gray-200'"
                                    class="flex-1 font-semibold text-center transition-colors"
                                    x-text="quality"
                                ></span>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <script src="public/assets/js/general.js"></script>
    </body>
</html>
